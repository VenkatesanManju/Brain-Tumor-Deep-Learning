# ==============================================================================
# Git Ignore Configuration for NeuroVision AI (Brain Tumor MRI Project)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Virtual Environments (Over 1 GB - CRITICAL TO IGNORE)
# ------------------------------------------------------------------------------
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. Large Datasets (Over 1.3 GB of MRI Scans, Archives, MAT files)
# Datasets should be downloaded separately as described in README.md
# ------------------------------------------------------------------------------
data/
*/data/
*.mat
*.tar
*.tar.gz
*.zip
*.7z
*.rar

# ------------------------------------------------------------------------------
# 3. Model Checkpoints & Large Neural Network Weights
# ResNet50.pt is ~90MB (GitHub blocks >100MB and warns >50MB).
# Distribute via GitHub Releases, Git LFS, or Hugging Face.
# ------------------------------------------------------------------------------
outputs/checkpoints/
*/outputs/checkpoints/
*.pt
*.pth
*.pwf
*.ckpt
*.h5
*.hdf5
*.bin
*.onnx
*.safetensors

# ------------------------------------------------------------------------------
# 4. Temporary Runtime Files, Logs, and Uploads
# ------------------------------------------------------------------------------
outputs/temp_pdf/
*/outputs/temp_pdf/
outputs/temp_upload.mat
*/outputs/temp_upload.mat
*.log
logs/
*/logs/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 5. Python Bytecode, Caches & Testing Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & OS Metadata
# ------------------------------------------------------------------------------
.vscode/
*/.vscode/
.idea/
*/.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 7. Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
