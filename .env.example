# ==============================================================================
# NeuroVision AI - Environment Configuration Template
# Copy this file to .env and adjust variables as required
# ==============================================================================

# Web Application Host and Port
HOST=127.0.0.1
PORT=5050

# PyTorch Execution Device ('cuda' or 'cpu')
DEVICE=cuda

# Model Checkpoints Directory
CHECKPOINT_DIR=outputs/checkpoints

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
